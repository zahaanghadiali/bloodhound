# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/bloodhound
# Database name on that cluster — swap this (not the URI) to point at a
# separate UAT vs. live database: "bloodhoundDB-UAT" for local testing
# (.env.local), "bloodhoundDB" for live (.env.production.local / Vercel).
# Defaults to "bloodhoundDB-UAT" if unset.
MONGODB_DB_NAME=bloodhoundDB-UAT

# Signs the session JWT issued on /api/auth/verify-otp and checked by
# proxy.js on every other /api/* request. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production

# WhatsApp Cloud API (fill in once you have them)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=

# Instagram Messaging API (fill in once you have them)
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_APP_SECRET=

# Default search radius for donor matching (km)
DEFAULT_SEARCH_RADIUS_KM=10

# Expanding-radius donor search (server/services/donorRequestService.js).
# Starts at the start radius, widens by the step every interval, up to the
# searcher's own chosen max, then asks them to go unlimited.
DONOR_REQUEST_START_RADIUS_KM=5
DONOR_REQUEST_EXPANSION_STEP_KM=10
DONOR_REQUEST_EXPANSION_INTERVAL_MINUTES=5
# Shared secret an external cron (e.g. an AWS EventBridge rule) must send as
# the "x-cron-secret" header to GET /api/donor-requests/tick. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DONOR_REQUEST_CRON_SECRET=change-me-in-production

# OTP verification for phone/email (registerDonor flow). Defaults to "mock" —
# no API keys needed; the code is shown right in the chat as
# "🧪 Dev mode — your code is ######". Switch to a real provider for
# production delivery:
OTP_SMS_PROVIDER=mock
OTP_EMAIL_PROVIDER=mock
OTP_CODE_TTL_MINUTES=5
OTP_HASH_SECRET=change-me-in-production

# Twilio (only used when OTP_SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Resend (only used when OTP_EMAIL_PROVIDER=resend)
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=

# Pet document storage (medical records). Defaults to "inline" — no setup
# needed; files are kept as base64 data URLs on the Pet document. Switch to
# "s3" once the AWS_* vars below are filled in to upload to S3 instead.
# The bucket is private — the app generates a short-lived signed URL each
# time a document needs to be viewed, it never gets a public link.
DOCUMENT_STORAGE_PROVIDER=inline

# AWS S3 (only used when DOCUMENT_STORAGE_PROVIDER=s3)
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# How long a signed "view this document" URL stays valid, in seconds.
DOCUMENT_SIGNED_URL_TTL_SECONDS=900

# Once a device/session OTP-verifies a phone number for the medical records
# chat flows (upload/view), it won't be asked again for this many days.
# Not used on WhatsApp — that channel already proves the phone number.
RECORDS_VERIFICATION_TTL_DAYS=180

# Reverse geocoding — turns a shared location into area/city/country.
# Leave GOOGLE_MAPS_API_KEY empty to use OpenStreetMap's free Nominatim
# service (no key; it asks for a contact email to identify the app). Set a
# Google key (Geocoding API enabled) for more reliable area names.
GOOGLE_MAPS_API_KEY=
GEOCODING_CONTACT_EMAIL=

# Website chat: "true" lets a session already bound to a verified profile
# skip the phone + code questions. Leave off to re-verify by code every time.
TRUST_WEB_SESSION_PHONE=false
