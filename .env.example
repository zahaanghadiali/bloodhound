# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/bloodhound

# WhatsApp Cloud API (fill in once you have them)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=

# Instagram Messaging API (fill in once you have them)
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_APP_SECRET=

# Default search radius for donor matching (km)
DEFAULT_SEARCH_RADIUS_KM=10

# OTP verification for phone/email (registerDonor flow). Defaults to "mock" —
# no API keys needed; the code is shown right in the chat as
# "🧪 Dev mode — your code is ######". Switch to a real provider for
# production delivery:
OTP_SMS_PROVIDER=mock
OTP_EMAIL_PROVIDER=mock
OTP_CODE_TTL_MINUTES=5
OTP_HASH_SECRET=change-me-in-production

# Twilio (only used when OTP_SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Resend (only used when OTP_EMAIL_PROVIDER=resend)
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
